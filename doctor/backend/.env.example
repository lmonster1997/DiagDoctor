# DiagDoctor 环境变量配置
# 复制此文件为 .env 并填入实际值

# LLM 配置（必填）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding 配置
# 主路径:DashScope(阿里)OpenAI 兼容 embedding API。配了 EMBEDDING_BASE_URL +
# DASHSCOPE_API_KEY 就走 API(不回退,防混模型)。EMBEDDING_DIMENSIONS 须与
# qdrant_client.VECTOR_SIZE 一致(1024)。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# Legacy offline fallback(EMBEDDING_BASE_URL 留空时才走):TEI / 本地 bge-m3。
# 与 API 路径不同模型,不可在同一 collection 混用。
# 走本地时默认离线（HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE 由代码 setdefault）。
# 二选一(都不填则尝试 hub 下载,会被 SSL 拦):
#   HF_HUB_CACHE  = HF cache 根(推荐,不写死 snapshot hash,库按 refs/main 解析)
#   BGE_M3_LOCAL_PATH = 直接指向 snapshot 目录(机器特定 hash)
# HF_HUB_CACHE=D:/hf_cache
# BGE_M3_LOCAL_PATH=D:/hf_cache/models--BAAI--bge-m3/snapshots/<hash>
# TEI_URL=http://localhost:8080

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=doctor-api

# 应用配置
DEBUG=false
PORT=8000

# Langfuse（LLM 可观测 & 评测，自托管）
# 从 Langfuse Dashboard → Settings → API Keys 获取
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3002